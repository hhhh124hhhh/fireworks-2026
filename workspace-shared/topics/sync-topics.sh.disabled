#!/bin/bash
# =========================================
# OpenClaw Topics Pool 双向同步脚本
# 架构: local + cloud 分文件 → merge → push
# =========================================

set -e

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$REPO_DIR"

SYNC_LOG="$REPO_DIR/sync.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] === Sync started ===" >> "$SYNC_LOG"

# Step 1: Fetch latest from remote
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Fetching origin..." >> "$SYNC_LOG"
git fetch origin >> "$SYNC_LOG" 2>&1

# Step 2: Check for remote updates and pull
LOCAL_HASH=$(git rev-parse HEAD)
REMOTE_HASH=$(git rev-parse origin/main)

if [ "$LOCAL_HASH" != "$REMOTE_HASH" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Remote has updates, pulling..." >> "$SYNC_LOG"
    git pull origin main --no-edit >> "$SYNC_LOG" 2>&1 || {
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Pull conflict, using ours" >> "$SYNC_LOG"
        git merge --abort >> "$SYNC_LOG" 2>&1 || true
    }
fi

# Step 3: Run merge (generates topics-pool-YYYYMMDD-HHMM.md)
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Running merge-topics.js..." >> "$SYNC_LOG"
node merge-topics.js >> "$SYNC_LOG" 2>&1

# Get the newly created merged file name
MERGED_FILE=$(ls -t topics-pool-20*.md 2>/dev/null | head -1)
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Merged file: $MERGED_FILE" >> "$SYNC_LOG"

# Step 4: Stage all changes
git add -A >> "$SYNC_LOG" 2>&1

# Step 5: Check if there are changes to commit
if git diff --cached --quiet; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] No changes to commit" >> "$SYNC_LOG"
else
    git commit -m "sync: $(date '+%Y-%m-%d %H:%M')" >> "$SYNC_LOG" 2>&1
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Changes committed" >> "$SYNC_LOG"
fi

# Step 6: Push to remote
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Pushing to origin..." >> "$SYNC_LOG"
git push origin main >> "$SYNC_LOG" 2>&1

echo "[$(date '+%Y-%m-%d %H:%M:%S')] === Sync completed ===" >> "$SYNC_LOG"
echo "Sync completed: $MERGED_FILE at $(date '+%Y-%m-%d %H:%M:%S')"
