#!/usr/bin/env node
/**
 * watch-sync.js
 * 监控本地文件变化，自动触发 sync
 * 使用 chokidar 实现跨平台文件监控
 */

const chokidar = require('chokidar');
const { exec, spawn } = require('child_process');
const path = require('path');

const REPO_DIR = __dirname;

// 要监控的文件模式
const WATCH_PATTERNS = [
  'topics-pool-local-*.md',
  'topics-pool-cloud-*.md',
  'topics-pool.md',
];

// 忽略的文件
const IGNORE_PATTERNS = [
  '**/sync.log',
  '**/.git/**',
  '**/node_modules/**',
];

// debounce: 避免短时间内多次触发
let pendingTimer = null;
const DEBOUNCE_MS = 3000;

function autoCommitAndSync() {
  if (pendingTimer) {
    clearTimeout(pendingTimer);
  }

  pendingTimer = setTimeout(() => {
    console.log(`[watch-sync] File change detected, auto-committing...`);

    // 1. 自动 git add + commit
    const addCommitCmd = `git add -A && git commit -m "auto-sync: $(date '+%Y-%m-%d %H:%M')"`;
    exec(addCommitCmd, { cwd: REPO_DIR }, (err, stdout, stderr) => {
      if (err && !err.message.includes('nothing to commit')) {
        console.error(`[watch-sync] Auto-commit failed: ${err.message}`);
        return;
      }

      if (err && err.message.includes('nothing to commit')) {
        console.log(`[watch-sync] No changes to commit, running sync anyway...`);
      } else {
        console.log(`[watch-sync] Auto-committed`);
      }

      // 2. 运行 sync（pull → merge → push）
      console.log(`[watch-sync] Running sync...`);
      const syncScript = path.join(REPO_DIR, 'sync-topics.sh');
      const logFile = path.join(REPO_DIR, 'sync-watch.log');

      const cmd = process.platform === 'win32'
        ? `bash "${syncScript}" >> "${logFile}" 2>&1`
        : `bash "${syncScript}" >> "${logFile}" 2>&1`;

      exec(cmd, (syncErr, syncOut, syncErr2) => {
        if (syncErr) {
          console.error(`[watch-sync] Sync failed: ${syncErr.message}`);
        } else {
          console.log(`[watch-sync] Sync completed`);
        }
      });
    });

    pendingTimer = null;
  }, DEBOUNCE_MS);
}

// 构建监控路径
const watchPaths = WATCH_PATTERNS.map(p => path.join(REPO_DIR, p));

console.log(`[watch-sync] Starting watcher on: ${REPO_DIR}`);
console.log(`[watch-sync] Patterns: ${WATCH_PATTERNS.join(', ')}`);

// 启动 chokidar 监控
const watcher = chokidar.watch(watchPaths, {
  ignored: IGNORE_PATTERNS,
  persistent: true,
  ignoreInitial: true,  // 忽略初始扫描
  awaitWriteFinish: {   // 等待文件写入完成
    stabilityThreshold: 1000,
    pollInterval: 100
  }
});

watcher
  .on('add', filePath => {
    console.log(`[watch-sync] File added: ${path.basename(filePath)}`);
    autoCommitAndSync();
  })
  .on('change', filePath => {
    console.log(`[watch-sync] File changed: ${path.basename(filePath)}`);
    autoCommitAndSync();
  })
  .on('unlink', filePath => {
    console.log(`[watch-sync] File removed: ${path.basename(filePath)}`);
    autoCommitAndSync();
  })
  .on('error', error => {
    console.error(`[watch-sync] Error: ${error.message}`);
  });

console.log(`[watch-sync] Watcher started. Press Ctrl+C to stop.`);

// 优雅退出
process.on('SIGINT', () => {
  console.log('\n[watch-sync] Stopping watcher...');
  watcher.close();
  process.exit(0);
});
