def sanitize_prompt(prompt):
    """净化提示词，移除可能被限制的词汇"""
    
    # 替换过于暴力的词汇
    replacements = {
        "厮杀": "切磋",
        "血腥": "激烈",
        "暴力": "竞技",
        "杀戮": "对决",
        "残忍": "认真",
        "虐杀": "切磋"
    }
    
    for old, new in replacements.items():
        prompt = prompt.replace(old, new)
    
    return prompt
```

