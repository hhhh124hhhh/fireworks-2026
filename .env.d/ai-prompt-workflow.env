# AI Prompt Workflow - 环境变量配置
# 使用方法: source /root/clawd/.env.d/ai-prompt-workflow.env

# GitHub API Token - 用于抓取 GitHub 仓库中的提示词
# 获取地址: https://github.com/settings/tokens (需要 repo 权限)
export GITHUB_TOKEN=""

# HuggingFace Token - 用于访问 HuggingFace 数据集
# 获取地址: https://huggingface.co/settings/tokens
export HUGGINGFACE_TOKEN=""

# Anthropic API Key - 用于 Claude 评估（必需）
# 获取地址: https://console.anthropic.com/
export ANTHROPIC_API_KEY=""

# Langfuse API Keys - 用于质量追踪（可选）
# 获取地址: https://cloud.langfuse.com/
export LANGFUSE_PUBLIC_KEY=""
export LANGFUSE_SECRET_KEY=""

# Twitter API Key - 用于 Twitter 数据收集（可选）
# 获取地址: https://twitterapi.io/
export TWITTER_API_KEY="your_twitter_api_key"
