[Unit]
Description=Private Twitter API Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/clawd/twitter-api-server
Environment="PATH=/root/clawd/twitter-api-server/venv/bin"
ExecStart=/root/clawd/twitter-api-server/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
