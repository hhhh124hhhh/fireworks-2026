      "platforms": ["zhihu", "weibo", "bilibili", "douyin", "toutiao", "baidu", "thepaper", "cls", "wallstreetcn", "tieba", "hackernews", "github", "v2ex", "arxiv", "producthunt"],
      "usage": "使用 MCP 工具调用，或通过 opencli 降级",
      "fallback": "opencli + Chrome DevTools (CDP 9222)"
    }
