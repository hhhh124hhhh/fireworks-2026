# AI 提示词系统环境变量配置
# 复制此文件为 .env 并填入实际值

# ============================================
# Claude API (评估功能必需)
# ============================================
# 获取方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# GitHub API (可选，用于抓取 GitHub 提示词)
# ============================================
# 获取方式: GitHub Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=your_github_token_here

# ============================================
# HuggingFace Token (可选，用于访问数据集)
# ============================================
# 获取方式: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ============================================
# Langfuse (可选，用于质量追踪)
# ============================================
# 获取方式: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key

# ============================================
# 高级配置 (可选)
# ============================================
# Langfuse 自部署地址
# LANGFUSE_HOST=https://your-langfuse-instance.com
